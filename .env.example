# Local server. Keep HOST on loopback until authentication is added.
HOST=127.0.0.1
PORT=3210
DATABASE_PATH=./data/tibao.sqlite

# TikTok Shop Partner Center application credentials.
# Register this OAuth callback in Partner Center for local use:
# http://127.0.0.1:3210/api/oauth/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
# TikTok Shop product catalog endpoints currently use this API version.
TIKTOK_PRODUCT_API_VERSION=202309

# 32+ random characters. Used to encrypt seller access tokens in SQLite.
TOKEN_ENCRYPTION_KEY=

# Shared only with the local Chrome extension.
EXTENSION_SHARED_KEY=

# Conservative defaults for the single-item submit endpoint.
API_MIN_INTERVAL_MS=750
# Read-only product/opportunity matching requests are sequential and paced separately.
MATCH_READ_INTERVAL_MS=250
API_MAX_ATTEMPTS=3
TASK_LEASE_MINUTES=30

# ReCut / AI video Alpha. The local runtime is intentionally embedded because
# the current database driver is SQLite.
VIDEO_FEATURE_ENABLED=true
VIDEO_STORAGE_DRIVER=local
VIDEO_STORAGE_ROOT=data/video-assets
VIDEO_TEMP_ROOT=data/video-tmp
VIDEO_MAX_SOURCE_BYTES=157286400
VIDEO_MAX_PRODUCT_IMAGE_BYTES=10485760
VIDEO_WORKER_MODE=embedded
VIDEO_JOB_POLL_MS=1000
VIDEO_JOB_LEASE_SECONDS=180
VIDEO_JOB_HEARTBEAT_SECONDS=45
VIDEO_WORKER_SHUTDOWN_GRACE_MS=10000
VIDEO_MEDIA_CONCURRENCY=1
VIDEO_TEXT_AI_CONCURRENCY=2
VIDEO_IMAGE_AI_CONCURRENCY=3
VIDEO_EVENT_POLL_ACTIVE_MS=500
VIDEO_EVENT_POLL_IDLE_MS=2000
VIDEO_ALLOWED_MARKETS=MY
VIDEO_ALLOWED_LANGUAGES=ms-MY,en-MY
VIDEO_ASSET_RETENTION_DAYS=30
# Keep separate from TOKEN_ENCRYPTION_KEY before any non-local deployment.
VIDEO_DATA_ENCRYPTION_KEY=
VIDEO_PROJECT_BUDGET_UNITS=100
# Phase A uses a deterministic fake provider. Leave enabled until a real adapter is configured.
VIDEO_FAKE_PROVIDER=true
