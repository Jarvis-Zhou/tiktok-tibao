# Local server. Keep HOST on loopback until authentication is added.
HOST=127.0.0.1
PORT=3210
# Keep loopback-only by default. Set 0.0.0.0 only when LAN access is required.
TIBAO_BIND_ADDRESS=127.0.0.1
DATABASE_PATH=./data/tibao.sqlite

# TikTok Shop Partner Center application credentials.
# Register this OAuth callback in Partner Center for local use:
# http://127.0.0.1:3210/api/oauth/tiktok/callback
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_API_BASE_URL=https://open-api.tiktokglobalshop.com
# TikTok Shop product catalog endpoints currently use this API version.
TIKTOK_PRODUCT_API_VERSION=202309

# 32+ random characters. Used to encrypt seller access tokens in SQLite.
TOKEN_ENCRYPTION_KEY=

# Shared only with the local Chrome extension.
EXTENSION_SHARED_KEY=

# Conservative defaults for the single-item submit endpoint.
API_MIN_INTERVAL_MS=750
# Read-only product/opportunity matching requests are sequential and paced separately.
MATCH_READ_INTERVAL_MS=250
API_MAX_ATTEMPTS=3
TASK_LEASE_MINUTES=30

# ReCut / AI video Alpha. The local runtime is intentionally embedded because
# the current database driver is SQLite.
VIDEO_FEATURE_ENABLED=true
# Container networking requires an internal 0.0.0.0 bind. Keep this false for
# direct host execution; compose.yaml overrides it and publishes only to 127.0.0.1.
VIDEO_ALLOW_NON_LOOPBACK_HOST=false
VIDEO_STORAGE_DRIVER=local
VIDEO_STORAGE_ROOT=data/video-assets
VIDEO_TEMP_ROOT=data/video-tmp
VIDEO_MAX_SOURCE_BYTES=157286400
VIDEO_MAX_PRODUCT_IMAGE_BYTES=10485760
VIDEO_WORKER_MODE=embedded
VIDEO_JOB_POLL_MS=1000
VIDEO_JOB_LEASE_SECONDS=180
VIDEO_JOB_HEARTBEAT_SECONDS=45
VIDEO_WORKER_SHUTDOWN_GRACE_MS=10000
VIDEO_MEDIA_CONCURRENCY=1
VIDEO_TEXT_AI_CONCURRENCY=2
VIDEO_IMAGE_AI_CONCURRENCY=3
VIDEO_EVENT_POLL_ACTIVE_MS=500
VIDEO_EVENT_POLL_IDLE_MS=2000
VIDEO_ALLOWED_MARKETS=MY
VIDEO_ALLOWED_LANGUAGES=ms-MY,en-MY
VIDEO_ASSET_RETENTION_DAYS=30
# Keep separate from TOKEN_ENCRYPTION_KEY before any non-local deployment.
VIDEO_DATA_ENCRYPTION_KEY=
VIDEO_PROJECT_BUDGET_UNITS=100
# Explicit analysis provider. `fake` is deterministic and must only be used for
# fixture/dev validation. Set `openai` to analyze real frames/product pixels.
VIDEO_AI_PROVIDER=fake
# Storyboard rendering can be selected independently. Keep this `fake` when a
# model gateway supports vision/text but does not expose an Images API.
VIDEO_AI_STORYBOARD_PROVIDER=fake
# Legacy compatibility switch; VIDEO_AI_PROVIDER takes precedence.
VIDEO_FAKE_PROVIDER=true
VIDEO_AI_BASE_URL=https://api.openai.com/v1
VIDEO_AI_API_KEY=
# Optional secret file. It may contain the raw key or JSON with OPENAI_API_KEY,
# VIDEO_AI_API_KEY, or ANTHROPIC_AUTH_TOKEN (including under an `env` object).
VIDEO_AI_API_KEY_FILE=
# GPT-5.6 Sol uses the Responses API for image understanding + structured prompt
# generation. `chat-completions` remains available for older compatible gateways.
VIDEO_AI_ANALYSIS_API=responses
VIDEO_AI_ANALYSIS_MODEL=gpt-5.6-sol
VIDEO_AI_REASONING_EFFORT=medium
# Used only when VIDEO_AI_STORYBOARD_PROVIDER=openai.
VIDEO_AI_IMAGE_MODEL=gpt-image-2
# Audio transcription: disabled | local | openai. The local mode calls the
# bundled faster-whisper sidecar; openai reuses VIDEO_AI_BASE_URL/API_KEY.
VIDEO_ASR_PROVIDER=disabled
# Required only for VIDEO_ASR_PROVIDER=openai. For backward compatibility, this
# still selects cloud ASR when VIDEO_ASR_PROVIDER is completely absent.
VIDEO_AI_TRANSCRIPTION_MODEL=
# Host-side default for `docker compose ... up local-asr` + `npm run dev`.
# Full Compose overrides this with the internal http://local-asr:8000/v1 URL.
VIDEO_LOCAL_ASR_BASE_URL=http://127.0.0.1:8001/v1
VIDEO_LOCAL_ASR_API_KEY=
VIDEO_LOCAL_ASR_MODEL=small
VIDEO_ASR_REQUEST_TIMEOUT_MS=600000
VIDEO_AI_REQUEST_TIMEOUT_MS=300000
VIDEO_AI_MAX_FRAMES=6
VIDEO_FFMPEG_PATH=ffmpeg
VIDEO_FFPROBE_PATH=ffprobe
VIDEO_MEDIA_PROCESS_TIMEOUT_MS=60000
VIDEO_MAX_DECODED_PIXELS=40000000
VIDEO_MAX_EXTRACTED_FRAMES=24
