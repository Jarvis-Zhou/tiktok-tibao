{
  "manifest_version": 3,
  "name": "Tibao · TikTok Shop 商品机会提报",
  "version": "0.2.1",
  "description": "从 Seller Center 采集当前页商品，并从本地 Tibao 队列辅助执行商品机会提报。",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:3210/*",
    "http://localhost:3210/*",
    "https://seller-mx.tiktok.com/*",
    "https://seller.tiktokglobalshop.com/*",
    "https://seller.tiktokshopglobalselling.com/*",
    "https://*.tiktokshop.com/*",
    "https://*.tiktokglobalshop.com/*"
  ],
  "action": {
    "default_title": "Tibao",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3210/*",
        "http://localhost:3210/*",
        "https://seller-mx.tiktok.com/*",
        "https://seller.tiktokglobalshop.com/*",
        "https://seller.tiktokshopglobalselling.com/*",
        "https://*.tiktokshop.com/*",
        "https://*.tiktokglobalshop.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
