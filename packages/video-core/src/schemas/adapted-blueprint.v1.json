{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tibao.local/schemas/adapted-blueprint.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_market", "language", "target_duration_sec", "similarity_score", "creative_strategy", "scenes", "localization_notes", "safety_notes"],
  "properties": {
    "schema_version": { "const": "1.0" }, "target_market": { "type": "string", "minLength": 2 }, "language": { "type": "string", "minLength": 2 },
    "target_duration_sec": { "type": "number", "minimum": 0, "multipleOf": 0.01 }, "similarity_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "creative_strategy": { "type": "string", "minLength": 1 }, "localization_notes": { "type": "array", "items": { "type": "string" } },
    "safety_notes": { "type": "array", "items": { "type": "string" } },
    "scenes": { "type": "array", "minItems": 3, "maxItems": 6, "items": { "$ref": "#/$defs/scene" } }
  },
  "$defs": {
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "source_shot_ids", "input_fact_refs", "start_sec", "end_sec", "purpose", "subject", "environment", "action", "camera", "lighting", "selling_point", "overlay_text", "voiceover", "retained_variables", "rewritten_variables", "adaptation_reason", "image_prompt", "video_prompt", "negative_prompt", "status"],
      "properties": {
        "scene_id": { "type": "string", "minLength": 1 }, "source_shot_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "input_fact_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "start_sec": { "type": "number", "minimum": 0, "multipleOf": 0.01 }, "end_sec": { "type": "number", "minimum": 0, "multipleOf": 0.01 },
        "purpose": { "type": "string", "minLength": 1 }, "subject": { "type": "string", "minLength": 1 }, "environment": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 }, "camera": { "type": "string", "minLength": 1 }, "lighting": { "type": "string", "minLength": 1 },
        "selling_point": { "type": "string", "minLength": 1 }, "overlay_text": { "type": "string" }, "voiceover": { "type": "string" },
        "retained_variables": { "type": "array", "items": { "type": "string" } }, "rewritten_variables": { "type": "array", "items": { "type": "string" } },
        "adaptation_reason": { "type": "string", "minLength": 1 }, "image_prompt": { "type": "string", "minLength": 1 },
        "video_prompt": { "type": "string", "minLength": 1 }, "negative_prompt": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "ready", "needs_review"] }
      }
    }
  }
}
